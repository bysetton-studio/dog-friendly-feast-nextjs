generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id              String   @id @default(uuid())
  name            String
  address         String
  isFriendly      Boolean
  isAdminApproved Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
