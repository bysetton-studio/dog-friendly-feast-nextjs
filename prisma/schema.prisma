generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id              String            @id @default(uuid())
  name            String
  address         String
  isFriendly      Boolean
  isAdminApproved Boolean           @default(false)
  types           String[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  resolved        ResolvedLocation?
}

// Caches the Google Places API response for a Location so we don't re-query on every request.
model ResolvedLocation {
  locationId String   @id
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  placeData  Json
  resolvedAt DateTime @default(now())

  @@map("resolved_locations")
}

// Daily request counter for the Maps API rate-limit cap.
// One row per UTC date; count is incremented atomically via raw SQL.
model MapsRateLimit {
  date  String @id // YYYY-MM-DD UTC
  count Int    @default(0)

  @@map("maps_rate_limit")
}
