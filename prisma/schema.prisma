generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id              String   @id @default(uuid())
  name            String
  address         String
  isFriendly      Boolean
  isAdminApproved Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Daily request counter for the Maps API rate-limit cap.
// One row per UTC date; count is incremented atomically via raw SQL.
model MapsRateLimit {
  date  String @id // YYYY-MM-DD UTC
  count Int    @default(0)

  @@map("maps_rate_limit")
}
